0001df 8000                          .DB 0b00000000, 0b10000000    ; Flash data bytes for Digits '8' and '9' segment patterns
0001e0 00f8                          .DB 0b11111000, 0b00000000    ; Flash data bytes for Index 10 (Blank/Off display output) and byte alignment padding
                                 
