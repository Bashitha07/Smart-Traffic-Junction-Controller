                                 .equ	RWW_STOP_ADDR	= 0x37ff
                                 .equ	PAGESIZE	= 64
                                 .equ	FIRSTBOOTSTART	= 0x3f00
                                 .equ	SECONDBOOTSTART	= 0x3e00
                                 .equ	THIRDBOOTSTART	= 0x3c00
                                 .equ	FOURTHBOOTSTART	= 0x3800
                                 .equ	SMALLBOOTSTART	= FIRSTBOOTSTART
                                 .equ	LARGEBOOTSTART	= FOURTHBOOTSTART
                                 
                                 
                                 
                                 ; ***** INTERRUPT VECTORS ************************************************
                                 .equ	INT0addr	= 0x0002	; External Interrupt Request 0
                                 .equ	INT1addr	= 0x0004	; External Interrupt Request 1
                                 .equ	PCI0addr	= 0x0006	; Pin Change Interrupt Request 0
                                 .equ	PCI1addr	= 0x0008	; Pin Change Interrupt Request 0
                                 .equ	PCI2addr	= 0x000a	; Pin Change Interrupt Request 1
                                 .equ	WDTaddr	= 0x000c	; Watchdog Time-out Interrupt
                                 .equ	OC2Aaddr	= 0x000e	; Timer/Counter2 Compare Match A
                                 .equ	OC2Baddr	= 0x0010	; Timer/Counter2 Compare Match A
                                 .equ	OVF2addr	= 0x0012	; Timer/Counter2 Overflow
                                 .equ	ICP1addr	= 0x0014	; Timer/Counter1 Capture Event
                                 .equ	OC1Aaddr	= 0x0016	; Timer/Counter1 Compare Match A
                                 .equ	OC1Baddr	= 0x0018	; Timer/Counter1 Compare Match B
                                 .equ	OVF1addr	= 0x001a	; Timer/Counter1 Overflow
                                 .equ	OC0Aaddr	= 0x001c	; TimerCounter0 Compare Match A
                                 .equ	OC0Baddr	= 0x001e	; TimerCounter0 Compare Match B
                                 .equ	OVF0addr	= 0x0020	; Timer/Couner0 Overflow
                                 .equ	SPIaddr	= 0x0022	; SPI Serial Transfer Complete
                                 .equ	URXCaddr	= 0x0024	; USART Rx Complete
                                 .equ	UDREaddr	= 0x0026	; USART, Data Register Empty
                                 .equ	UTXCaddr	= 0x0028	; USART Tx Complete
                                 .equ	ADCCaddr	= 0x002a	; ADC Conversion Complete
                                 .equ	ERDYaddr	= 0x002c	; EEPROM Ready
                                 .equ	ACIaddr	= 0x002e	; Analog Comparator
                                 .equ	TWIaddr	= 0x0030	; Two-wire Serial Interface
                                 .equ	SPMRaddr	= 0x0032	; Store Program Memory Read
                                 
                                 .equ	INT_VECTORS_SIZE	= 52	; size in words
                                 
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ; IE3064 Embedded Systems Engineering — Smart Traffic Junction Controller
                                 ; Target        : ATmega328P (Arduino Uno / Standalone), 16 MHz Crystal
                                 ; Language      : Pure AVR Assembly (avrasm2)
                                 ; Toolchain     : Microchip Studio 7 / Atmel Studio
                                 ;
                                 ; Compliance summary:
                                 ;   - Two-phase (N-S / E-W) intersection.
                                 ;   - Every direction changes  GREEN -> YELLOW -> RED  when stopping and
                                 ;     RED -> YELLOW -> GREEN  when starting (pre-green yellow). Never
                                 ;     red -> green directly.
                                 ;   - Sequence: NS_GREEN 3s, NS_YELLOW 2s, ALL_RED 1s, EW_PREP(yellow) 1s,
                                 ;               EW_GREEN 3s, EW_YELLOW 2s, ALL_RED 1s, NS_PREP(yellow) 1s
                                 ;     Total normal cycle = 3+2+1+1+3+2+1+1 = 14s (< 15s).
                                 ;   - Pedestrian crossing: deferred request via INT0/PD2 hardware interrupt,
                                 ;     started only after the vehicle phase and its All-Red clearance have
                                 ;     completed. ALL FOUR directions stay red for the 5s countdown, then
                                 ;     the next direction shows yellow before green (red->yellow->green).
                                 ;   - 7-seg: COMMON_CATHODE switch (5161AS = cathode: COM->GND).
                                 ;   - Night mode: LDR on ADC0/PC0, flashes both Yellow signals at 1 Hz.
                                 ;   - Hysteresis: requires 5s (10 ticks) of bright light to exit Night mode.
                                 ;==============================================================================
                                 
                                 .LIST
                                 
                                 ;==============================================================================
                                 ; SECTION 1: CONSTANTS & PIN DEFINITIONS
                                 ;==============================================================================
                                 
                                 ; ---- FSM State Numbers (Encoded States for the Traffic Controller) ---------
                                 .EQU STATE_NS_GREEN     = 0     ; North-South Green active phase
                                 .EQU STATE_NS_YELLOW    = 1     ; North-South yellow transition (EW red)
                                 .EQU STATE_ALL_RED_1    = 2     ; All-Red safety clearance after N-S phase
                                 .EQU STATE_EW_PREP      = 3     ; East-West pre-green yellow warning
                                 .EQU STATE_EW_GREEN     = 4     ; East-West Green active phase
                                 .EQU STATE_EW_YELLOW    = 5     ; East-West yellow transition (NS red)
                                 .EQU STATE_ALL_RED_2    = 6     ; All-Red safety clearance after E-W phase
                                 .EQU STATE_NS_PREP      = 7     ; North-South pre-green yellow warning
                                 .EQU STATE_PEDESTRIAN   = 8     ; Pedestrian crossing active state (All Red)
                                 .EQU STATE_NIGHT        = 9     ; Night mode active (Flashing Yellow)
                                 
                                 ; ---- Timing Constants (Configured in seconds, Total Normal Cycle = 14s) ----
                                 .EQU TIME_NS_GREEN   = 3     ; North-South Green duration (3s)
                                 .EQU TIME_NS_YELLOW  = 2     ; North-South Yellow duration (2s)
                                 .EQU TIME_ALL_RED    = 1     ; Intersection All-Red Clearance (1s)
                                 .EQU TIME_PRE_GREEN  = 1     ; Red->Yellow pre-green safety warning (1s)
                                 .EQU TIME_EW_GREEN   = 3     ; East-West Green duration (3s)
                                 .EQU TIME_EW_YELLOW  = 2     ; East-West Yellow duration (2s)
                                 
                                 ; ---- Pedestrian & Night Mode Configuration Parameters ---------------------
                                 .EQU PED_COUNT_START    = 5      ; Pedestrian crossing countdown window (5 seconds)
                                 .EQU HYSTERESIS_TICKS   = 10     ; 10 ticks * 500ms = 5000ms (5 consecutive seconds of light required to exit Night mode)
                                 .EQU LIGHT_THRESHOLD    = 100    ; ADCH reading below this threshold = Dark (triggers Night Mode)
                                 
                                 ; ---- PORTB Bit Mapping (Traffic Light LED Outputs) ------------------------
                                 .EQU NS_RED   = 0    ; PB0: North-South Red LED
                                 .EQU NS_YEL   = 1    ; PB1: North-South Yellow LED
                                 .EQU NS_GRN   = 2    ; PB2: North-South Green LED
                                 .EQU EW_RED   = 3    ; PB3: East-West Red LED
                                 .EQU EW_YEL   = 4    ; PB4: East-West Yellow LED
                                 .EQU EW_GRN   = 5    ; PB5: East-West Green LED
                                 
                                 ; ---- 7-Segment Display Configuration ----------------------------------------
                                 ; 1 = COMMON CATHODE (e.g., 5161AS): Common pin connected to GND, segments active HIGH
                                 .EQU COMMON_CATHODE  = 1
                                 
                                 ; ---- PORTD Bit Mapping ----------------------------------------------------
                                 .EQU PED_BTN  = 2    ; PD2: INT0 Hardware Interrupt Pedestrian Push-Button Input
                                 
                                 ;==============================================================================
                                 ; SECTION 2: SRAM DATA MEMORY (State Variables & Flags)
                                 ;==============================================================================
                                 .DSEG
                                 .ORG SRAM_START
                                 
000100                           current_state:        .BYTE 1     ; Stores active FSM state index (1 byte in SRAM)
000101                           seconds_in_state:     .BYTE 1     ; Elapsed full seconds within the current state (1 byte)
000102                           resume_state:         .BYTE 1     ; Stores vehicle state to resume after pedestrian crossing (1 byte)
000103                           pedestrian_flag:      .BYTE 1     ; Flag: 1 = Pedestrian crossing requested via button (1 byte)
000104                           pedestrian_countdown: .BYTE 1     ; Active countdown value (5 down to 0) (1 byte)
000105                           hysteresis_counter:   .BYTE 1     ; Tracks consecutive 500ms ticks of bright light (1 byte)
000106                           adc_result:           .BYTE 1     ; Stores the latest 8-bit ADCH reading from LDR (1 byte)
000107                           tick_flag:            .BYTE 1     ; Set by Timer1 ISR every 500ms to drive main loop (1 byte)
000108                           half_tick_counter:    .BYTE 1     ; Toggles every 500ms (2 ticks = exactly 1 second) (1 byte)
000109                           flash_state:          .BYTE 1     ; Toggle variable (0/1) for 1 Hz night mode flashing (1 byte)
                                 
                                 ;==============================================================================
                                 ; SECTION 3: INTERRUPT VECTOR TABLE
                                 ;==============================================================================
                                 .CSEG
                                 .ORG 0x0000
000000 940c 0035                     jmp RESET              ; 0x0000: System Reset Vector (Jump to boot initialization)
000002 940c 008a                     jmp ISR_INT0           ; 0x0002: External Interrupt 0 (Pedestrian Button on PD2)
000004 940c 0034                     jmp DEFAULT_ISR        ; 0x0004: INT1 (Unused, catch-all)
000006 940c 0034                     jmp DEFAULT_ISR        ; 0x0006: PCINT0 (Unused, catch-all)
000008 940c 0034                     jmp DEFAULT_ISR        ; 0x0008: PCINT1 (Unused, catch-all)
00000a 940c 0034                     jmp DEFAULT_ISR        ; 0x000A: PCINT2 (Unused, catch-all)
00000c 940c 0034                     jmp DEFAULT_ISR        ; 0x000C: WDT (Unused, catch-all)
00000e 940c 0034                     jmp DEFAULT_ISR        ; 0x000E: TIMER2 COMPA (Unused, catch-all)
000010 940c 0034                     jmp DEFAULT_ISR        ; 0x0010: TIMER2 COMPB (Unused, catch-all)
000012 940c 0034                     jmp DEFAULT_ISR        ; 0x0012: TIMER2 OVF (Unused, catch-all)
000014 940c 0034                     jmp DEFAULT_ISR        ; 0x0014: TIMER1 CAPT (Unused, catch-all)
000016 940c 0098                     jmp ISR_TIMER1_COMPA   ; 0x0016: Timer1 Compare Match A (500ms system tick timer interrupt)
000018 940c 0034                     jmp DEFAULT_ISR        ; 0x0018: TIMER1 COMPB (Unused, catch-all)
00001a 940c 0034                     jmp DEFAULT_ISR        ; 0x001A: TIMER1 OVF (Unused, catch-all)
00001c 940c 0034                     jmp DEFAULT_ISR        ; 0x001C: TIMER0 COMPA (Unused, catch-all)
00001e 940c 0034                     jmp DEFAULT_ISR        ; 0x001E: TIMER0 COMPB (Unused, catch-all)
000020 940c 0034                     jmp DEFAULT_ISR        ; 0x0020: TIMER0 OVF (Unused, catch-all)
000022 940c 0034                     jmp DEFAULT_ISR        ; 0x0022: SPI STC (Unused, catch-all)
000024 940c 0034                     jmp DEFAULT_ISR        ; 0x0024: USART RX (Unused, catch-all)
000026 940c 0034                     jmp DEFAULT_ISR        ; 0x0026: USART UDRE (Unused, catch-all)
000028 940c 0034                     jmp DEFAULT_ISR        ; 0x0028: USART TX (Unused, catch-all)
00002a 940c 0034                     jmp DEFAULT_ISR        ; 0x002A: ADC Conversion Complete (Unused, polled mode used instead)
00002c 940c 0034                     jmp DEFAULT_ISR        ; 0x002C: EEPROM Ready (Unused, catch-all)
00002e 940c 0034                     jmp DEFAULT_ISR        ; 0x002E: Analog Comparator (Unused, catch-all)
000030 940c 0034                     jmp DEFAULT_ISR        ; 0x0030: TWI / I2C (Unused, catch-all)
000032 940c 0034                     jmp DEFAULT_ISR        ; 0x0032: Store Program Memory Ready (Unused, catch-all)
                                 
                                 DEFAULT_ISR:
000034 9518                          reti                   ; Catch-all dummy ISR: return from interrupt immediately for unhandled vectors
                                 
                                 ;==============================================================================
                                 ; SECTION 4: INITIALISATION & MAIN SUPERVISOR LOOP
                                 ;==============================================================================
                                 
                                 RESET:
                                     ; Initialize Hardware Stack Pointer to top of RAM
000035 ef0f                          ldi   r16, low(RAMEND)        ; Load low byte of RAM top address into r16 (e.g., 0xFF for ATmega328P)
000036 bf0d                          out   SPL, r16                ; Write low byte into Stack Pointer Low register (SPL)
000037 e008                          ldi   r16, high(RAMEND)       ; Load high byte of RAM top address into r16 (e.g., 0x08 for ATmega328P)
000038 bf0e                          out   SPH, r16                ; Write high byte into Stack Pointer High register (SPH)
                                 
                                     ; Initialize Microcontroller Peripherals
000039 d026                          rcall init_ports              ; Call subroutine to set up I/O pin directions and pull-ups
00003a d032                          rcall init_timer1             ; Call subroutine to configure Timer1 for 500ms intervals
00003b d041                          rcall init_adc                ; Call subroutine to configure the LDR analog-to-digital converter
00003c d047                          rcall init_int0               ; Call subroutine to configure the pedestrian button external interrupt
                                 
                                     ; Clear and Initialize SRAM Variables
00003d 2700                          clr   r16                     ; Clear register r16 (sets r16 = 0x00)
00003e 9300 0101                     sts   seconds_in_state, r16   ; Clear state timer counter in SRAM
000040 9300 0103                     sts   pedestrian_flag, r16    ; Clear pedestrian call flag in SRAM (0 = no call pending)
000042 9300 0104                     sts   pedestrian_countdown, r16; Clear pedestrian crossing countdown variable in SRAM
000044 9300 0105                     sts   hysteresis_counter, r16 ; Clear LDR stability counter in SRAM
000046 9300 0107                     sts   tick_flag, r16          ; Clear 500ms timer tick flag in SRAM
000048 9300 0108                     sts   half_tick_counter, r16  ; Clear 500ms half-tick auxiliary counter in SRAM
00004a 9300 0109                     sts   flash_state, r16        ; Clear night mode flash toggle state in SRAM
                                     
                                     ; Set starting traffic state to North-South Green
00004c e000                          ldi   r16, STATE_NS_GREEN     ; Load constant value representing NS Green state (0) into r16
00004d 9300 0100                     sts   current_state, r16      ; Save starting state ID into SRAM variable 'current_state'
                                 
                                     ; Apply Initial Hardware Outputs
00004f d12d                          rcall update_leds_for_state   ; Drive physical traffic light pins to match NS Green state
000050 e03a                          ldi   r19, 10                 ; Load index value 10 into r19 (Index 10 makes 7-segment display blank)
000051 d165                          rcall update_countdown_display ; Output blank character to 7-segment display at boot
                                 
                                     ; Configure Sleep Mode (Idle Mode) to optimize simulator CPU efficiency
000052 e001                          ldi   r16, (1<<SE)            ; Set Sleep Enable (SE) bit in r16
000053 bf03                          out   SMCR, r16               ; Write config byte to Sleep Mode Control Register (SMCR)
                                 
000054 9478                          sei                           ; Enable Global Interrupts (Sets I-bit in SREG)
                                 
                                 main_loop:
000055 9100 0107                     lds   r16, tick_flag          ; Load the 500ms tick flag from SRAM into r16
000057 2300                          tst   r16                     ; Test r16 contents (sets Zero flag if r16 == 0x00)
000058 f411                          brne  do_tick                 ; If tick_flag is non-zero (timer expired), jump to do_tick processing
000059 9588                          sleep                         ; Otherwise, put CPU in low-power idle sleep until next interrupt wakes it
00005a cffa                          rjmp  main_loop               ; Unconditional jump back to re-check tick flag after waking up
                                 
                                 do_tick:
00005b 2700                          clr   r16                     ; Clear register r16 (r16 = 0x00)
00005c 9300 0107                     sts   tick_flag, r16          ; Reset tick flag in SRAM so it handles only once per tick interval
00005e d043                          rcall handle_tick             ; Execute core FSM state transitions, time updates, and LDR sensor checking
00005f cff5                          rjmp  main_loop               ; Unconditional jump back to main loop
                                 
                                 ;==============================================================================
                                 ; SECTION 5: PERIPHERAL INITIALISATION SUBROUTINES
                                 ;==============================================================================
                                 
                                 init_ports:
                                     ; PORTB Setup: PB0..PB5 configured as outputs for Traffic Light LEDs
000060 e30f                          ldi   r16, 0b00111111         ; Set bits 0 to 5 as output drivers
000061 b904                          out   DDRB, r16               ; Write configuration to Data Direction Register B
000062 2700                          clr   r16                     ; Clear r16 (0x00)
000063 b905                          out   PORTB, r16              ; Ensure all PORTB output pins start LOW
                                 
                                     ; PORTD Setup: PD2 configured as input (Pedestrian Button), PD3..PD7 as outputs (7-seg segments A..E)
000064 ef08                          ldi   r16, 0b11111000         ; Set bits 3-7 as outputs, bits 0-2 as inputs
000065 b90a                          out   DDRD, r16               ; Write configuration to Data Direction Register D
000066 e004                          ldi   r16, (1<<PED_BTN)        ; Create bitmask for PD2 pull-up resistor activation
000067 b90b                          out   PORTD, r16              ; Activate internal pull-up resistor on pedestrian push-button input pin (PD2)
                                 
                                     ; PORTC Setup: PC0 configured as input (LDR ADC), PC1/PC2 configured as outputs (7-seg segments F,G)
000068 e006                          ldi   r16, 0b00000110         ; Set PC1 and PC2 as outputs, PC0 (ADC0) as analog input
000069 b907                          out   DDRC, r16               ; Write configuration to Data Direction Register C
00006a 2700                          clr   r16                     ; Clear r16
00006b b908                          out   PORTC, r16              ; Set PORTC outputs LOW
00006c 9508                          ret                           ; Return from subroutine
                                 
                                 init_timer1:
                                     ; Setup Timer1 in CTC Mode (Clear Timer on Compare Match, TOP = OCR1A)
                                     ; Prescaler = 256. For 16 MHz crystal: 16,000,000 / 256 = 62,500 Hz clock.
                                     ; Target tick interval = 500ms (0.5s). Counts = 62,500 * 0.5 = 31,250.
                                     ; OCR1A = 31250 - 1 = 31249 (0x7A11)
00006d 2700                          clr   r16                     ; Clear r16
00006e 9300 0080                     sts   TCCR1A, r16             ; Clear Timer/Counter 1 Control Register A (normal port operation)
000070 e00c                          ldi   r16, (1<<WGM12) | (1<<CS12) ; Enable CTC mode (WGM12=1) and set Prescaler to 256 (CS12=1)
000071 9300 0081                     sts   TCCR1B, r16             ; Write configuration to TCCR1B
000073 e70a                          ldi   r16, high(31249)        ; Load high byte of compare match target count (0x7A) into r16
000074 9300 0089                     sts   OCR1AH, r16             ; Store high byte into Output Compare Register 1 A High
000076 e101                          ldi   r16, low(31249)         ; Load low byte of compare match target count (0x11) into r16
000077 9300 0088                     sts   OCR1AL, r16             ; Store low byte into Output Compare Register 1 A Low
000079 e002                          ldi   r16, (1<<OCIE1A)        ; Create bitmask to enable Timer1 Compare Match A Interrupt
00007a 9300 006f                     sts   TIMSK1, r16             ; Write mask to Timer Interrupt Mask Register 1
00007c 9508                          ret                           ; Return from subroutine
                                 
                                 init_adc:
                                     ; Configure ADC: AVcc reference voltage, Left-adjusted result (8-bit resolution in ADCH), Channel ADC0 (PC0)
00007d e600                          ldi   r16, (1<<REFS0) | (1<<ADLAR) ; REFS0 = AVcc reference with external capacitor on AREF, ADLAR = Left adjust result for 8-bit read
00007e 9300 007c                     sts   ADMUX, r16              ; Write configuration to ADC Multiplexer Selection Register
                                     ; Enable ADC peripheral, set Prescaler to 128 (16 MHz / 128 = 125 kHz safe ADC operating clock)
000080 e807                          ldi   r16, (1<<ADEN) | (1<<ADPS2) | (1<<ADPS1) | (1<<ADPS0) ; ADEN = Enable ADC, ADPS2..0 = Prescaler division factor 128
000081 9300 007a                     sts   ADCSRA, r16             ; Write configuration to ADC Control and Status Register A
000083 9508                          ret                           ; Return from subroutine
                                 
                                 init_int0:
                                     ; Configure External Interrupt INT0 (PD2) to trigger on falling edge (button press to ground)
000084 e002                          ldi   r16, (1<<ISC01)         ; ISC01 = 1, ISC00 = 0 sets falling edge interrupt trigger mode for INT0
000085 9300 0069                     sts   EICRA, r16              ; Write configuration to External Interrupt Control Register A
000087 e001                          ldi   r16, (1<<INT0)          ; Create bitmask to enable external interrupt request 0
000088 bb0d                          out   EIMSK, r16              ; Write mask to External Interrupt Mask Register
000089 9508                          ret                           ; Return from subroutine
                                 
                                 ;==============================================================================
                                 ; SECTION 6: INTERRUPT SERVICE ROUTINES (ISRs)
                                 ;==============================================================================
                                 
                                 ISR_INT0:
00008a 930f                          push  r16                     ; Save register r16 onto the hardware stack
00008b b70f                          in    r16, SREG               ; Read Status Register (SREG) into r16 to save CPU flags
00008c 930f                          push  r16                     ; Save SREG value onto the stack
                                 
                                     ; Safety Check: Ignore pedestrian button presses if currently in Night Mode
00008d 9100 0100                     lds   r16, current_state      ; Load current state index from SRAM into r16
00008f 3009                          cpi   r16, STATE_NIGHT        ; Compare current state with Night Mode state ID (9)
000090 f019                          breq  int0_exit               ; If in night mode, skip setting pedestrian flag and exit
                                 
                                     ; Set deferred pedestrian crossing request flag
000091 e001                          ldi   r16, 1                  ; Load value 1 into r16 indicating a pending pedestrian request
000092 9300 0103                     sts   pedestrian_flag, r16    ; Store flag in SRAM variable 'pedestrian_flag'
                                 
                                 int0_exit:
000094 910f                          pop   r16                     ; Restore saved SREG value from stack into r16
000095 bf0f                          out   SREG, r16               ; Restore CPU status flags
000096 910f                          pop   r16                     ; Restore original r16 register contents from stack
000097 9518                          reti                          ; Return from interrupt (automatically re-enables global interrupts)
                                 
                                 ISR_TIMER1_COMPA:
000098 930f                          push  r16                     ; Save r16 register onto stack
000099 b70f                          in    r16, SREG               ; Read Status Register into r16
00009a 930f                          push  r16                     ; Save SREG onto stack
                                 
00009b e001                          ldi   r16, 1                  ; Load value 1 into r16
00009c 9300 0107                     sts   tick_flag, r16          ; Set tick_flag in SRAM to signal main loop that 500ms has elapsed
                                 
00009e 910f                          pop   r16                     ; Restore SREG from stack
00009f bf0f                          out   SREG, r16               ; Restore status flags
0000a0 910f                          pop   r16                     ; Restore r16 from stack
0000a1 9518                          reti                          ; Return from interrupt
                                 
                                 ;==============================================================================
                                 ; SECTION 7: CORE FSM LOGIC & TIMING CONTROLLER
                                 ;==============================================================================
                                 
                                 handle_tick:
0000a2 d0cc                          rcall read_adc                 ; Call helper function to sample LDR light sensor value into adc_result variable
                                 
0000a3 9100 0100                     lds   r16, current_state      ; Load current FSM state from SRAM into r16
0000a5 3009                          cpi   r16, STATE_NIGHT        ; Compare state with Night Mode ID
0000a6 f409                          brne  check_darkness          ; If not in night mode, proceed to check ambient light levels
0000a7 c0ad                          rjmp  process_night_mode       ; If already in night mode, jump directly to night mode management routine
                                 
                                 check_darkness:
                                     ; --- NORMAL / PEDESTRIAN ENVIRONMENT MONITORING ---
0000a8 9110 0106                     lds   r17, adc_result         ; Load latest 8-bit LDR ADC reading from SRAM into r17
0000aa 3614                          cpi   r17, LIGHT_THRESHOLD    ; Compare ADC reading against light threshold constant (100)
0000ab f408                          brsh  tick_timer              ; If ADC value >= 100 (bright ambient light), continue normal timing cycle
0000ac c09c                          rjmp  enter_night_mode         ; If ADC value < 100 (dark ambient conditions), switch immediately to Night Mode
                                 
                                 tick_timer:
                                     ; Convert 500ms ticks into 1-second increments (2 ticks = 1 second)
0000ad 9100 0108                     lds   r16, half_tick_counter  ; Load current half-tick flip-flop counter state into r16
0000af e011                          ldi   r17, 1                  ; Load bitmask value 1 into r17
0000b0 2701                          eor   r16, r17                ; Exclusive-OR half_tick_counter with 1 (toggles 0 to 1, or 1 to 0)
0000b1 9300 0108                     sts   half_tick_counter, r16  ; Save toggled state back to SRAM variable 'half_tick_counter'
0000b3 2300                          tst   r16                     ; Test r16 (sets Zero flag if toggle resulted in 0x00)
0000b4 f009                          breq  second_elapsed          ; If Zero flag is set (every 2nd tick = 1 full second), proceed to update state timers
0000b5 c0b8                          rjmp  exit_tick               ; Otherwise (first 500ms half-tick), exit tick handler and wait for next tick
                                 
                                 second_elapsed:
                                     ; --- EXACTLY 1 SECOND HAS PASSED: UPDATE FSM ---
0000b6 9100 0100                     lds   r16, current_state      ; Load current state index into r16
0000b8 3008                          cpi   r16, STATE_PEDESTRIAN   ; Check if system is currently executing a pedestrian crossing countdown
0000b9 f409                          brne  increment_timer         ; If not in pedestrian mode, proceed to increment standard vehicle state timer
0000ba c075                          rjmp  process_pedestrian_countdown ; If in pedestrian mode, jump to handle pedestrian countdown decrementing
                                 
                                 increment_timer:
0000bb 9110 0101                     lds   r17, seconds_in_state   ; Load elapsed seconds count for the current state from SRAM into r17
0000bd 9513                          inc   r17                     ; Increment elapsed second counter by 1
0000be 9310 0101                     sts   seconds_in_state, r17   ; Store updated second count back into SRAM variable 'seconds_in_state'
                                 
                                     ; FSM State Dispatcher Trampoline table (Evaluates current state using sequential conditional jumps)
0000c0 3000                          cpi   r16, STATE_NS_GREEN     ; Compare current state with North-South Green ID (0)
0000c1 f409                          brne  skip_ns_green           ; If not NS Green, skip to next state check
0000c2 c016                          rjmp  check_ns_green          ; If NS Green, jump to evaluate its duration timeout
                                 
                                 skip_ns_green:
0000c3 3001                          cpi   r16, STATE_NS_YELLOW    ; Compare state with North-South Yellow ID (1)
0000c4 f409                          brne  skip_ns_yellow          ; If not NS Yellow, skip
0000c5 c01a                          rjmp  check_ns_yellow         ; Jump to evaluate NS Yellow duration timeout
                                 
                                 skip_ns_yellow:
0000c6 3002                          cpi   r16, STATE_ALL_RED_1    ; Compare state with First All-Red Clearance ID (2)
0000c7 f409                          brne  skip_all_red_1          ; If not All-Red 1, skip
0000c8 c01e                          rjmp  check_all_red_1         ; Jump to evaluate All-Red 1 duration timeout
                                 
                                 skip_all_red_1:
0000c9 3003                          cpi   r16, STATE_EW_PREP      ; Compare state with East-West Pre-Green Yellow ID (3)
0000ca f409                          brne  skip_ew_prep            ; If not EW Prep, skip
0000cb c02b                          rjmp  check_ew_prep           ; Jump to evaluate EW Prep duration timeout
                                 
                                 skip_ew_prep:
0000cc 3004                          cpi   r16, STATE_EW_GREEN     ; Compare state with East-West Green ID (4)
0000cd f409                          brne  skip_ew_green           ; If not EW Green, skip
0000ce c02f                          rjmp  check_ew_green          ; Jump to evaluate EW Green duration timeout
                                 
                                 skip_ew_green:
0000cf 3005                          cpi   r16, STATE_EW_YELLOW    ; Compare state with East-West Yellow ID (5)
0000d0 f409                          brne  skip_ew_yellow          ; If not EW Yellow, skip
0000d1 c033                          rjmp  check_ew_yellow         ; Jump to evaluate EW Yellow duration timeout
                                 
                                 skip_ew_yellow:
0000d2 3006                          cpi   r16, STATE_ALL_RED_2    ; Compare state with Second All-Red Clearance ID (6)
0000d3 f409                          brne  skip_all_red_2          ; If not All-Red 2, skip
0000d4 c037                          rjmp  check_all_red_2         ; Jump to evaluate All-Red 2 duration timeout
                                 
                                 skip_all_red_2:
0000d5 3007                          cpi   r16, STATE_NS_PREP      ; Compare state with North-South Pre-Green Yellow ID (7)
0000d6 f409                          brne  skip_ns_prep            ; If not NS Prep, skip
0000d7 c044                          rjmp  check_ns_prep           ; Jump to evaluate NS Prep duration timeout
                                 
                                 skip_ns_prep:
0000d8 c095                          rjmp  exit_tick               ; Fallback safety exit if state index is unhandled
                                 
                                 ; --- INDIVIDUAL FSM PHASE DURATION EVALUATION ---
                                 
                                 check_ns_green:
0000d9 9110 0101                     lds   r17, seconds_in_state   ; Load elapsed seconds in NS Green state
0000db 3013                          cpi   r17, TIME_NS_GREEN       ; Compare elapsed time against duration constant (3 seconds)
0000dc f408                          brsh  end_ns_green            ; If elapsed time >= 3s, branch to transition out of NS Green
0000dd c090                          rjmp  exit_tick               ; Otherwise, duration not met yet; exit tick handler
                                 end_ns_green:
0000de e001                          ldi   r16, STATE_NS_YELLOW    ; Load next state ID (STATE_NS_YELLOW = 1) into r16
0000df c062                          rjmp  change_state            ; Jump to state transition helper routine
                                 
                                 check_ns_yellow:
0000e0 9110 0101                     lds   r17, seconds_in_state   ; Load elapsed seconds in NS Yellow state
0000e2 3012                          cpi   r17, TIME_NS_YELLOW      ; Compare elapsed time against duration constant (2 seconds)
0000e3 f408                          brsh  end_ns_yellow           ; If elapsed time >= 2s, branch to transition out of NS Yellow
0000e4 c089                          rjmp  exit_tick               ; Otherwise, exit tick handler
                                 end_ns_yellow:
0000e5 e002                          ldi   r16, STATE_ALL_RED_1    ; Load next state ID (STATE_ALL_RED_1 = 2) into r16
0000e6 c05b                          rjmp  change_state            ; Jump to state transition routine
                                 
                                 check_all_red_1:
0000e7 9110 0101                     lds   r17, seconds_in_state   ; Load elapsed seconds in All-Red 1 state
0000e9 3011                          cpi   r17, TIME_ALL_RED        ; Compare elapsed time against duration constant (1 second)
0000ea f408                          brsh  end_all_red_1           ; If elapsed time >= 1s, branch to complete clearance
0000eb c082                          rjmp  exit_tick               ; Otherwise, exit tick handler
                                 end_all_red_1:
                                     ; All-red clearance complete: check if pedestrian button was pressed during the cycle
0000ec 9120 0103                     lds   r18, pedestrian_flag    ; Load pedestrian request flag from SRAM into r18
0000ee 2322                          tst   r18                     ; Test flag (sets Zero flag if pedestrian_flag == 0)
0000ef f411                          brne  ped_from_ar1            ; If flag is non-zero (pedestrian button was pushed), branch to handle pedestrian crossing
0000f0 e003                          ldi   r16, STATE_EW_PREP      ; Normal flow: load EW pre-green yellow warning state ID (3) into r16
0000f1 c050                          rjmp  change_state            ; Jump to state transition routine
                                 ped_from_ar1:
0000f2 e003                          ldi   r16, STATE_EW_PREP      ; Load resumption state ID (EW pre-green yellow warning = 3) into r16
0000f3 9300 0102                     sts   resume_state, r16       ; Save this state in SRAM variable 'resume_state' to resume traffic after pedestrian phase
0000f5 e008                          ldi   r16, STATE_PEDESTRIAN   ; Load Pedestrian crossing state ID (8) into r16
0000f6 c02c                          rjmp  start_pedestrian_phase  ; Jump to initialize pedestrian crossing mode
                                 
                                 check_ew_prep:
0000f7 9110 0101                     lds   r17, seconds_in_state   ; Load elapsed seconds in EW Prep state
0000f9 3011                          cpi   r17, TIME_PRE_GREEN      ; Compare elapsed time against duration constant (1 second)
0000fa f408                          brsh  end_ew_prep             ; If elapsed time >= 1s, branch to transition out of EW Prep
0000fb c072                          rjmp  exit_tick               ; Otherwise, exit tick handler
                                 end_ew_prep:
0000fc e004                          ldi   r16, STATE_EW_GREEN     ; Load next state ID (STATE_EW_GREEN = 4) into r16
0000fd c044                          rjmp  change_state            ; Jump to state transition routine
                                 
                                 check_ew_green:
0000fe 9110 0101                     lds   r17, seconds_in_state   ; Load elapsed seconds in EW Green state
000100 3013                          cpi   r17, TIME_EW_GREEN       ; Compare elapsed time against duration constant (3 seconds)
000101 f408                          brsh  end_ew_green            ; If elapsed time >= 3s, branch to transition out of EW Green
000102 c06b                          rjmp  exit_tick               ; Otherwise, exit tick handler
                                 end_ew_green:
000103 e005                          ldi   r16, STATE_EW_YELLOW    ; Load next state ID (STATE_EW_YELLOW = 5) into r16
000104 c03d                          rjmp  change_state            ; Jump to state transition routine
                                 
                                 check_ew_yellow:
000105 9110 0101                     lds   r17, seconds_in_state   ; Load elapsed seconds in EW Yellow state
000107 3012                          cpi   r17, TIME_EW_YELLOW      ; Compare elapsed time against duration constant (2 seconds)
000108 f408                          brsh  end_ew_yellow           ; If elapsed time >= 2s, branch to transition out of EW Yellow
000109 c064                          rjmp  exit_tick               ; Otherwise, exit tick handler
                                 end_ew_yellow:
00010a e006                          ldi   r16, STATE_ALL_RED_2    ; Load next state ID (STATE_ALL_RED_2 = 6) into r16
00010b c036                          rjmp  change_state            ; Jump to state transition routine
                                 
                                 check_all_red_2:
00010c 9110 0101                     lds   r17, seconds_in_state   ; Load elapsed seconds in All-Red 2 state
00010e 3011                          cpi   r17, TIME_ALL_RED        ; Compare elapsed time against duration constant (1 second)
00010f f408                          brsh  end_all_red_2           ; If elapsed time >= 1s, branch to complete clearance
000110 c05d                          rjmp  exit_tick               ; Otherwise, exit tick handler
                                 end_all_red_2:
                                     ; All-red clearance complete: check if pedestrian button was pressed during the cycle
000111 9120 0103                     lds   r18, pedestrian_flag    ; Load pedestrian request flag from SRAM into r18
000113 2322                          tst   r18                     ; Test flag
000114 f411                          brne  ped_from_ar2            ; If flag is non-zero, branch to handle pedestrian crossing
000115 e007                          ldi   r16, STATE_NS_PREP      ; Normal flow: load NS pre-green yellow warning state ID (7) into r16
000116 c02b                          rjmp  change_state            ; Jump to state transition routine
                                 ped_from_ar2:
000117 e007                          ldi   r16, STATE_NS_PREP      ; Load resumption state ID (NS pre-green yellow warning = 7) into r16
000118 9300 0102                     sts   resume_state, r16       ; Save resumption state in SRAM variable 'resume_state'
00011a e008                          ldi   r16, STATE_PEDESTRIAN   ; Load Pedestrian crossing state ID (8) into r16
00011b c007                          rjmp  start_pedestrian_phase  ; Jump to initialize pedestrian crossing mode
                                 
                                 check_ns_prep:
00011c 9110 0101                     lds   r17, seconds_in_state   ; Load elapsed seconds in NS Prep state
00011e 3011                          cpi   r17, TIME_PRE_GREEN      ; Compare elapsed time against duration constant (1 second)
00011f f408                          brsh  end_ns_prep             ; If elapsed time >= 1s, branch to transition out of NS Prep
000120 c04d                          rjmp  exit_tick               ; Otherwise, exit tick handler
                                 end_ns_prep:
000121 e000                          ldi   r16, STATE_NS_GREEN     ; Load next state ID (STATE_NS_GREEN = 0) to loop back to start of normal cycle
000122 c01f                          rjmp  change_state            ; Jump to state transition routine
                                 
                                 
                                 start_pedestrian_phase:
000123 9300 0100                     sts   current_state, r16      ; Store Pedestrian state ID (8) into 'current_state' in SRAM
000125 2700                          clr   r16                     ; Clear r16 (0x00)
000126 9300 0101                     sts   seconds_in_state, r16   ; Reset elapsed seconds counter for the pedestrian state
000128 9300 0103                     sts   pedestrian_flag, r16    ; Clear pedestrian request flag in SRAM (acknowledges request)
00012a e035                          ldi   r19, PED_COUNT_START    ; Load countdown start value constant (5 seconds) into r19
00012b 9330 0104                     sts   pedestrian_countdown, r19 ; Store countdown value into SRAM variable 'pedestrian_countdown'
00012d d04f                          rcall update_leds_for_state   ; Update traffic light hardware outputs (all red during pedestrian phase)
00012e d088                          rcall update_countdown_display ; Output countdown number '5' to the 7-segment display
00012f c03e                          rjmp  exit_tick               ; Exit tick handler
                                 
                                 process_pedestrian_countdown:
000130 9130 0104                     lds   r19, pedestrian_countdown ; Load remaining pedestrian countdown seconds from SRAM into r19
000132 2333                          tst   r19                     ; Test countdown value (sets Zero flag if r19 == 0)
000133 f409                          brne  countdown_not_zero      ; If countdown is not zero yet, branch to decrement it
000134 c008                          rjmp  end_pedestrian_phase    ; If countdown has reached zero, jump to terminate pedestrian phase
                                 countdown_not_zero:
000135 953a                          dec   r19                     ; Decrement countdown value by 1 second
000136 9330 0104                     sts   pedestrian_countdown, r19 ; Store updated countdown value back into SRAM
000138 d07e                          rcall update_countdown_display ; Update 7-segment display with new countdown digit
000139 3030                          cpi   r19, 0                  ; Compare updated countdown with 0
00013a f409                          brne  countdown_still_going   ; If not zero yet, branch to exit tick
00013b c001                          rjmp  end_pedestrian_phase    ; If countdown just hit zero, terminate pedestrian phase
                                 countdown_still_going:
00013c c031                          rjmp  exit_tick               ; Exit tick handler
                                 
                                 end_pedestrian_phase:
00013d e03a                          ldi   r19, 10                 ; Load index value 10 into r19 to blank the 7-segment display
00013e d078                          rcall update_countdown_display ; Output blank display pattern to hardware
00013f 9100 0102                     lds   r16, resume_state       ; Load saved vehicle resumption state from SRAM into r16
000141 c000                          rjmp  change_state            ; Jump to state transition routine to resume normal traffic sequence
                                 
                                 change_state:
000142 9300 0100                     sts   current_state, r16      ; Store new state ID into SRAM variable 'current_state'
000144 2700                          clr   r16                     ; Clear r16 (0x00)
000145 9300 0101                     sts   seconds_in_state, r16   ; Reset phase elapsed seconds timer variable in SRAM to 0
000147 d035                          rcall update_leds_for_state   ; Update physical traffic light LED outputs for the new state
000148 c025                          rjmp  exit_tick               ; Exit tick handler
                                 
                                 ; --- NIGHT MODE & SENSOR HYSTERESIS LOGIC ---
                                 
                                 enter_night_mode:
000149 e009                          ldi   r16, STATE_NIGHT        ; Load Night Mode state ID (9) into r16
00014a 9300 0100                     sts   current_state, r16      ; Store Night state ID into SRAM variable 'current_state'
00014c 2700                          clr   r16                     ; Clear r16 (0x00)
00014d 9300 0105                     sts   hysteresis_counter, r16  ; Reset stabilization counter variable in SRAM to 0
00014f 9300 0109                     sts   flash_state, r16        ; Clear flash toggle variable in SRAM
000151 e03a                          ldi   r19, 10                 ; Load index value 10 into r19 to blank 7-segment display in night mode
000152 d064                          rcall update_countdown_display ; Output blank display pattern
000153 d029                          rcall update_leds_for_state   ; Update hardware LED outputs for night mode
000154 c019                          rjmp  exit_tick               ; Exit tick handler
                                 
                                 process_night_mode:
                                     ; Toggle 1 Hz flash state every 500ms tick
000155 9100 0109                     lds   r16, flash_state        ; Load current flash toggle state (0 or 1) from SRAM into r16
000157 9500                          com   r16                     ; Perform logical one's complement bit inversion on r16 (flips 0 to 255, 1 to 254)
000158 7001                          andi  r16, 0x01               ; Mask out all bits except bit 0 (results in clean alternating 0 / 1 toggle)
000159 9300 0109                     sts   flash_state, r16        ; Store updated flash state back into SRAM variable 'flash_state'
00015b d021                          rcall update_leds_for_state   ; Update yellow LED flashing output based on new flash state
                                 
                                     ; Hysteresis Filtering: Check if ambient light has returned
00015c 9110 0106                     lds   r17, adc_result         ; Load latest LDR ADC reading from SRAM into r17
00015e 3614                          cpi   r17, LIGHT_THRESHOLD    ; Compare ADC reading against light threshold constant (100)
00015f f408                          brsh  bright_light_detected   ; If ADC value >= 100 (light returned), branch to increment hysteresis stability counter
000160 c00a                          rjmp  reset_hysteresis         ; If ADC value < 100 (still dark), jump to clear/reset hysteresis counter
                                     
                                 bright_light_detected:
                                     ; Bright light detected: increment consecutive stability counter
000161 9120 0105                     lds   r18, hysteresis_counter ; Load current consecutive stability tick count from SRAM into r18
000163 9523                          inc   r18                     ; Increment stability tick count by 1
000164 9320 0105                     sts   hysteresis_counter, r18 ; Store updated count back into SRAM variable 'hysteresis_counter'
000166 302a                          cpi   r18, HYSTERESIS_TICKS   ; Compare stability count against threshold constant (10 ticks = 5 seconds)
000167 f408                          brsh  hysteresis_complete     ; If stability count >= 10 ticks, branch to confirm return to normal mode
000168 c005                          rjmp  exit_tick               ; Otherwise, keep waiting in night mode; exit tick handler
                                 
                                 hysteresis_complete:
                                     ; 5 consecutive seconds of bright light confirmed -> Safely exit Night Mode to NS Pre-Green
000169 e007                          ldi   r16, STATE_NS_PREP      ; Load North-South Pre-Green Yellow warning state ID (7) into r16
00016a cfd7                          rjmp  change_state            ; Jump to state transition routine to resume normal operation
                                 
                                 reset_hysteresis:
00016b 2700                          clr   r16                     ; Clear r16 (0x00)
00016c 9300 0105                     sts   hysteresis_counter, r16 ; Reset hysteresis stability counter in SRAM back to 0 because darkness re-occurred
                                 
                                 exit_tick:
00016e 9508                          ret                           ; Return from handle_tick subroutine
                                 
                                 ;==============================================================================
                                 ; SECTION 8: HARDWARE HELPER FUNCTIONS
                                 ;==============================================================================
                                 
                                 read_adc:
00016f 9100 007a                     lds   r16, ADCSRA             ; Load ADC Control and Status Register A from SRAM into r16
000171 6400                          ori   r16, (1<<ADSC)          ; Set Start Conversion bit (ADSC) using bitwise OR (r16 |= 0x40)
000172 9300 007a                     sts   ADCSRA, r16             ; Write updated control byte back to ADCSRA to trigger analog-to-digital conversion
                                 wait_adc:
000174 9100 007a                     lds   r16, ADCSRA             ; Load ADCSRA status register into r16
000176 fd06                          sbrc  r16, ADSC               ; Skip next instruction if ADSC bit has cleared (hardware clears ADSC automatically when conversion finishes)
000177 cffc                          rjmp  wait_adc                ; If ADSC is still set, loop back to wait for conversion completion
000178 9100 0079                     lds   r16, ADCH               ; Read 8-bit left-adjusted conversion result byte from ADC Data Register High (ADCH)
00017a 9300 0106                     sts   adc_result, r16         ; Store 8-bit LDR sensor reading into SRAM variable 'adc_result'
00017c 9508                          ret                           ; Return from subroutine
                                 
                                 update_leds_for_state:
00017d 9100 0100                     lds   r16, current_state      ; Load current state index from SRAM into r16
                                     
00017f 3000                          cpi   r16, STATE_NS_GREEN     ; Compare state with NS Green (0)
000180 f409                          brne  chk_ns_yel              ; If not match, branch to check next state
000181 c01c                          rjmp  led_ns_green            ; If match, jump to NS Green LED pattern routine
                                 chk_ns_yel:
000182 3001                          cpi   r16, STATE_NS_YELLOW    ; Compare state with NS Yellow (1)
000183 f409                          brne  chk_ar1                 ; If not match, branch
000184 c01c                          rjmp  led_ns_yellow           ; Jump to NS Yellow LED pattern routine
                                 chk_ar1:
000185 3002                          cpi   r16, STATE_ALL_RED_1    ; Compare state with All-Red 1 clearance (2)
000186 f409                          brne  chk_ew_prep             ; If not match, branch
000187 c01c                          rjmp  led_all_red             ; Jump to All-Red LED pattern routine
                                 chk_ew_prep:
000188 3003                          cpi   r16, STATE_EW_PREP      ; Compare state with EW Prep warning (3)
000189 f409                          brne  chk_ew_grn              ; If not match, branch
00018a c01f                          rjmp  led_ew_yellow           ; Jump to EW Yellow LED pattern routine (EW Pre-Green warning)
                                 chk_ew_grn:
00018b 3004                          cpi   r16, STATE_EW_GREEN     ; Compare state with EW Green (4)
00018c f409                          brne  chk_ew_yel              ; If not match, branch
00018d c019                          rjmp  led_ew_green            ; Jump to EW Green LED pattern routine
                                 chk_ew_yel:
00018e 3005                          cpi   r16, STATE_EW_YELLOW    ; Compare state with EW Yellow (5)
00018f f409                          brne  chk_ar2                 ; If not match, branch
000190 c019                          rjmp  led_ew_yellow           ; Jump to EW Yellow LED pattern routine
                                 chk_ar2:
000191 3006                          cpi   r16, STATE_ALL_RED_2    ; Compare state with All-Red 2 clearance (6)
000192 f409                          brne  chk_ns_prep             ; If not match, branch
000193 c010                          rjmp  led_all_red             ; Jump to All-Red LED pattern routine
                                 chk_ns_prep:
000194 3007                          cpi   r16, STATE_NS_PREP      ; Compare state with NS Prep warning (7)
000195 f409                          brne  chk_ped                 ; If not match, branch
000196 c00a                          rjmp  led_ns_yellow           ; Jump to NS Yellow LED pattern routine (NS Pre-Green warning)
                                 chk_ped:
000197 3008                          cpi   r16, STATE_PEDESTRIAN   ; Compare state with Pedestrian crossing (8)
000198 f409                          brne  chk_night               ; If not match, branch
000199 c00a                          rjmp  led_all_red             ; Jump to All-Red LED pattern routine (all red during pedestrian phase)
                                 chk_night:
00019a 3009                          cpi   r16, STATE_NIGHT        ; Compare state with Night Mode (9)
00019b f409                          brne  led_ret                 ; If not match, branch to return
00019c c010                          rjmp  led_night               ; Jump to Night Mode flashing LED pattern routine
                                 led_ret:
00019d 9508                          ret                           ; Return from subroutine
                                 
                                 led_ns_green:
00019e e00c                          ldi   r16, (1<<NS_GRN) | (1<<EW_RED) ; Create bitmask: turn ON North-South Green (PB2) and East-West Red (PB3)
00019f b905                          out   PORTB, r16              ; Write LED output bitmask directly to PORTB data register
0001a0 9508                          ret                           ; Return from subroutine
                                 
                                 led_ns_yellow:
0001a1 e00a                          ldi   r16, (1<<NS_YEL) | (1<<EW_RED) ; Create bitmask: turn ON North-South Yellow (PB1) and East-West Red (PB3)
0001a2 b905                          out   PORTB, r16              ; Write bitmask to PORTB
0001a3 9508                          ret                           ; Return from subroutine
                                 
                                 led_all_red:
0001a4 e009                          ldi   r16, (1<<NS_RED) | (1<<EW_RED) ; Create bitmask: turn ON both North-South Red (PB0) and East-West Red (PB3)
0001a5 b905                          out   PORTB, r16              ; Write bitmask to PORTB
0001a6 9508                          ret                           ; Return from subroutine
                                 
                                 led_ew_green:
0001a7 e201                          ldi   r16, (1<<NS_RED) | (1<<EW_GRN) ; Create bitmask: turn ON North-South Red (PB0) and East-West Green (PB5)
0001a8 b905                          out   PORTB, r16              ; Write bitmask to PORTB
0001a9 9508                          ret                           ; Return from subroutine
                                 
                                 led_ew_yellow:
0001aa e101                          ldi   r16, (1<<NS_RED) | (1<<EW_YEL) ; Create bitmask: turn ON North-South Red (PB0) and East-West Yellow (PB4)
0001ab b905                          out   PORTB, r16              ; Write bitmask to PORTB
0001ac 9508                          ret                           ; Return from subroutine
                                 
                                 led_night:
0001ad 9110 0109                     lds   r17, flash_state        ; Load current night flash toggle state (0 or 1) from SRAM into r17
0001af 2311                          tst   r17                     ; Test flash state value (sets Zero flag if r17 == 0)
0001b0 f019                          breq  led_night_off           ; If Zero flag is set (flash state is 0), branch to turn night flash yellows OFF
0001b1 e102                          ldi   r16, (1<<NS_YEL) | (1<<EW_YEL) ; If flash state is 1, create bitmask to turn ON both Yellow LEDs (PB1 and PB4)
0001b2 b905                          out   PORTB, r16              ; Write bitmask to PORTB
0001b3 9508                          ret                           ; Return from subroutine
                                 led_night_off:
0001b4 2700                          clr   r16                     ; Clear r16 (0x00)
0001b5 b905                          out   PORTB, r16              ; Write 0x00 to PORTB to turn OFF both Yellow LEDs
0001b6 9508                          ret                           ; Return from subroutine
                                 
                                 update_countdown_display:
                                     ; Input: r19 = countdown value (0..5), or 10 for blank display.
0001b7 930f                          push  r16                     ; Save register r16 onto stack
0001b8 931f                          push  r17                     ; Save register r17 onto stack
0001b9 93ef                          push  r30                     ; Save Z-pointer low register (r30) onto stack
0001ba 93ff                          push  r31                     ; Save Z-pointer high register (r31) onto stack
                                 
0001bb 303a                          cpi   r19, 10                 ; Compare input value in r19 against 10 (blank index)
0001bc f008                          brlo  load_tables             ; If r19 < 10 (valid digit 0-9), proceed to load segment lookup tables
0001bd e03a                          ldi   r19, 10                 ; If r19 >= 10, force index to 10 (ensures safe fallback for blank display output)
                                 
                                 load_tables:
                                     ; Fetch PORTD segment bit patterns (Segments A, B, C, D, E mapped to PD3..PD7)
0001be ebe6                          ldi   ZL, low(countdown_portd_table * 2) ; Load low byte of Flash program memory table base address into ZL (multiplied by 2 for byte addressing)
0001bf e0f3                          ldi   ZH, high(countdown_portd_table * 2); Load high byte of Flash table address into ZH
0001c0 0fe3                          add   ZL, r19                 ; Add countdown digit index offset (0-10) to ZL pointer
0001c1 2711                          clr   r17                     ; Clear r17 (0x00)
0001c2 1ff1                          adc   ZH, r17                 ; Add carry bit to ZH high byte pointer if addition overflowed
0001c3 9104                          lpm   r16, Z                  ; Load Program Memory byte from Flash address pointed by Z into r16
                                 .IF COMMON_CATHODE
0001c4 9500                          com   r16                     ; Invert active-low table values because hardware uses Common Cathode display (Active HIGH)
0001c5 7f08                          andi  r16, 0b11111000         ; Apply bitmask to preserve only segment output pins PD3..PD7 (masking out PD0-PD2)
                                 .ENDIF
                                 
0001c6 b11b                          in    r17, PORTD              ; Read current PORTD register state into r17
0001c7 7017                          andi  r17, 0b00000111         ; Apply bitmask to preserve lower PORTD bits (PD0..PD2 button/UART lines)
0001c8 2b01                          or    r16, r17                ; Combine calculated 7-segment output pattern with preserved lower PORTD bits
0001c9 b90b                          out   PORTD, r16              ; Write final combined byte to PORTD output data register
                                 
                                     ; Fetch PORTC segment bit patterns (Segments F, G mapped to PC1, PC2)
0001ca ece2                          ldi   ZL, low(countdown_portc_table * 2) ; Load low byte of PORTC segment Flash table address into ZL
0001cb e0f3                          ldi   ZH, high(countdown_portc_table * 2); Load high byte of PORTC table address into ZH
0001cc 0fe3                          add   ZL, r19                 ; Add digit index offset to ZL pointer
0001cd 2711                          clr   r17                     ; Clear r17
0001ce 1ff1                          adc   ZH, r17                 ; Add potential carry bit to ZH
0001cf 9104                          lpm   r16, Z                  ; Load program memory segment byte from Flash into r16
                                 .IF COMMON_CATHODE
0001d0 9500                          com   r16                     ; Invert byte for Common Cathode active-HIGH display configuration
0001d1 7006                          andi  r16, 0b00000110         ; Apply bitmask to preserve only segment pins PC1 and PC2
                                 .ENDIF
                                 
0001d2 b118                          in    r17, PORTC              ; Read current PORTC register state into r17
0001d3 7f19                          andi  r17, 0b11111001         ; Apply bitmask to preserve PC0 (LDR ADC input) and higher PC pins
0001d4 2b01                          or    r16, r17                ; Combine calculated segment bits with preserved PORTC pins
0001d5 b908                          out   PORTC, r16              ; Write final combined byte to PORTC output data register
                                 
0001d6 91ff                          pop   r31                     ; Restore Z-pointer high register from stack
0001d7 91ef                          pop   r30                     ; Restore Z-pointer low register from stack
0001d8 911f                          pop   r17                     ; Restore r17 register from stack
0001d9 910f                          pop   r16                     ; Restore r16 register from stack
0001da 9508                          ret                           ; Return from subroutine
                                 
